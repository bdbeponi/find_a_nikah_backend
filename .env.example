# Copy to .env and fill in. The server refuses to start if anything here is
# missing, still a placeholder, or unsafe for production — see src/config/env.js.

PORT = 8007

MONGODB_URL = mongodb://user:password@host:27017/find_a_nikah?authSource=admin

# Generate each one separately, and never reuse the same value for both:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET =
ACCESS_TOKEN_EXPIRY = 1d
REFRESH_TOKEN_SECRET =
REFRESH_TOKEN_EXPIRY = 10d

# "production" turns on secure cookies, HSTS, and hides internal error messages
NODE_ENV = development

BACKEND_PUBLIC_URL = http://localhost:8007
FRONTEND_PUBLIC_URL = http://localhost:3002

# Comma separated list of allowed browser origins.
# In production these must be https — the auth cookies are secure+sameSite=none
# and a browser silently drops them over plain http.
CORS_ORIGIN = http://localhost:3002

# Only read by `npm run seed`. Set these rather than changing the password later.
SEED_ADMIN_PHONE = 01800000000
SEED_ADMIN_PASSWORD =

# ------------------------------------------------------------------- caching
# Leave empty and nothing is cached - the app reads MongoDB on every request.
#
# Set it and the public read endpoints are served from Redis for a few minutes.
# Every successful create/update/delete empties the cache, so an admin edit is
# visible immediately. Requests that carry a login are never cached.
#
#   local:      redis://127.0.0.1:6379
#   with auth:  redis://default:PASSWORD@host:6379
#   TLS:        rediss://default:PASSWORD@host:6380
REDIS_URL =

# ------------------------------------------------------------------ payments
# Shared with the payment gateway. Every webhook carries an HMAC-SHA256 of its
# own raw body under `x-signature`, and that signature is the only thing
# authenticating the call - there is no session on it.
#
# Leave it empty and the webhook refuses everything, which is the safe way round:
# a missing secret must never be read as "skip the check".
PAYMENT_WEBHOOK_SECRET =
